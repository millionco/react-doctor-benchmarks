+++ b/scripts/sync-leaderboard.ts
@@ -0,0 +1,171 @@
+#!/usr/bin/env -S node --experimental-strip-types
+/**
+ * Sync the React Doctor leaderboard from millionco/react-doctor-benchmarks.
+ *
+ * - Fetches results/leaderboard.json from the benchmarks repo (or reads it from
+ *   a local path passed as the first CLI arg).
+ * - Writes the full JSON blob to packages/website/src/app/leaderboard/leaderboard-data.json
+ *   so the website can render the page from a static asset.
+ * - Splices a top-10 markdown table into packages/react-doctor/README.md between
+ *   the `<!-- LEADERBOARD:START -->` and `<!-- LEADERBOARD:END -->` markers.
+ *
+ * Idempotent: writes only when content changes, so the CI commit step turns
+ * into a no-op when scores are unchanged.
+ */
+
+import { readFile, writeFile } from "node:fs/promises";
+import { dirname, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const SCRIPT_DIRECTORY = dirname(fileURLToPath(import.meta.url));
+const REPO_ROOT = resolve(SCRIPT_DIRECTORY, "..");
+
+const LEADERBOARD_URL =
+  "https://raw.githubusercontent.com/millionco/react-doctor-benchmarks/main/results/leaderboard.json";
+const README_PATH = resolve(REPO_ROOT, "packages/react-doctor/README.md");
+const DATA_PATH = resolve(REPO_ROOT, "packages/website/src/app/leaderboard/leaderboard-data.json");
+
+const README_TOP_COUNT = 10;
+const SCORE_GOOD_THRESHOLD = 75;
+const SCORE_OK_THRESHOLD = 50;
+const SCORE_BAR_WIDTH = 20;
+const PERFECT_SCORE = 100;
+
+const LEADERBOARD_START_MARKER = "<!-- LEADERBOARD:START -->";
+const LEADERBOARD_END_MARKER = "<!-- LEADERBOARD:END -->";
+const BENCHMARKS_REPO_URL = "https://github.com/millionco/react-doctor-benchmarks";
+const BENCHMARKS_TREE_URL = `${BENCHMARKS_REPO_URL}/tree/main`;
+
+interface LeaderboardEntry {
+  slug: string;
+  name: string;
+  githubUrl: string;
+  packageName: string;
+  score: number;
+  errorCount: number;
+  warningCount: number;
+  fileCount: number;
+  commitSha: string | null;
+  scannedAt: string;
+}
+
+interface LeaderboardSource {
+  repo: string;
+  path: string;
+  docs: string;
+}
+
+interface Leaderboard {
+  schemaVersion: number;
+  generatedAt: string;
+  doctorVersion: string | null;
+  source: LeaderboardSource;
+  entries: LeaderboardEntry[];
+}
+
+const fetchLeaderboard = async (sourceArgument: string | undefined): Promise<Leaderboard> => {
+  if (sourceArgument && sourceArgument.length > 0) {
+    const localRaw = await readFile(resolve(process.cwd(), sourceArgument), "utf8");
+    return JSON.parse(localRaw) as Leaderboard;
+  }
+  const response = await fetch(LEADERBOARD_URL);
+  if (!response.ok) {
+    throw new Error(
+      `Failed to fetch ${LEADERBOARD_URL}: ${response.status} ${response.statusText}`,
+    );
+  }
+  return (await response.json()) as Leaderboard;
+};
+
+const scoreEmoji = (score: number): string => {
+  if (score >= SCORE_GOOD_THRESHOLD) return "🟢";
+  if (score >= SCORE_OK_THRESHOLD) return "🟡";
+  return "🔴";
+};
+
+const scoreBar = (score: number): string => {
+  const filled = Math.round((score / PERFECT_SCORE) * SCORE_BAR_WIDTH);
+  const empty = SCORE_BAR_WIDTH - filled;
+  return `\`${"█".repeat(filled)}${"░".repeat(empty)}\``;
+};
+
+const escapePipe = (value: string): string => value.replace(/\|/g, "\\|");
+
+const renderReadmeBlock = (leaderboard: Leaderboard): string => {
+  const top = [...leaderboard.entries]
+    .sort((leftEntry, rightEntry) => rightEntry.score - leftEntry.score)
+    .slice(0, README_TOP_COUNT);
+
+  const lines: string[] = [];
+  lines.push("");
+  lines.push("| Rank | Project | Score | Errors | Warnings | Files |");
+  lines.push("|-----:|---------|:-----:|------:|--------:|------:|");
+  top.forEach((entry, index) => {
+    const cells = [
+      String(index + 1),
+      `[${escapePipe(entry.name)}](${entry.githubUrl})`,
+      `${scoreEmoji(entry.score)} ${scoreBar(entry.score)} **${entry.score}**/100`,
+      String(entry.errorCount),
+      String(entry.warningCount),
+      String(entry.fileCount),
+    ];
+    lines.push(`| ${cells.join(" | ")} |`);
+  });
+
+  lines.push("");
+  const doctorVersion = leaderboard.doctorVersion
+    ? `react-doctor \`${leaderboard.doctorVersion}\``
+    : "react-doctor";
+  const generatedAt = new Date(leaderboard.generatedAt).toISOString();
+  lines.push(
+    `<sub>Top ${top.length} of ${leaderboard.entries.length}. Updated <strong>${generatedAt}</strong> via ${doctorVersion}. See the [full leaderboard](${BENCHMARKS_TREE_URL}) and [score every popular React project](${BENCHMARKS_REPO_URL}#adding-a-project).</sub>`,
+  );
+  lines.push("");
+  return lines.join("\n");
+};
+
+const spliceReadme = (readme: string, block: string): string => {
+  const startIndex = readme.indexOf(LEADERBOARD_START_MARKER);
+  const endIndex = readme.indexOf(LEADERBOARD_END_MARKER);
+  if (startIndex < 0 || endIndex < 0 || endIndex < startIndex) {
+    throw new Error(
+      `README.md is missing leaderboard markers (${LEADERBOARD_START_MARKER} / ${LEADERBOARD_END_MARKER}).`,
+    );
+  }
+  const before = readme.slice(0, startIndex + LEADERBOARD_START_MARKER.length);
+  const after = readme.slice(endIndex);
+  return `${before}\n${block}\n${after}`;
+};
+
+const writeIfChanged = async (filePath: string, contents: string): Promise<boolean> => {
+  let existing: string | null = null;
+  try {
+    existing = await readFile(filePath, "utf8");
+  } catch {
+    existing = null;
+  }
+  if (existing === contents) {
+    return false;
+  }
+  await writeFile(filePath, contents, "utf8");
+  return true;
+};
+
+const main = async (): Promise<void> => {
+  const sourceArgument = process.argv[2];
+  const leaderboard = await fetchLeaderboard(sourceArgument);
+
+  const dataContents = `${JSON.stringify(leaderboard, null, 2)}\n`;
+  const dataChanged = await writeIfChanged(DATA_PATH, dataContents);
+  console.log(dataChanged ? `wrote ${DATA_PATH}` : `${DATA_PATH} unchanged`);
+
+  const readmeExisting = await readFile(README_PATH, "utf8");
+  const readmeNext = spliceReadme(readmeExisting, renderReadmeBlock(leaderboard));
+  const readmeChanged = await writeIfChanged(README_PATH, readmeNext);
+  console.log(readmeChanged ? `wrote ${README_PATH}` : `${README_PATH} unchanged`);
+};
+
+main().catch((error) => {
+  console.error(error);
+  process.exit(1);
+});
-- 
2.43.0


