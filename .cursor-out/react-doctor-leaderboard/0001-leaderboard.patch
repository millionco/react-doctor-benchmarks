Subject: [PATCH 4/5] ci: refresh leaderboard from react-doctor-benchmarks

Daily scheduled workflow (plus manual + repository_dispatch triggers)
that runs scripts/sync-leaderboard.ts. When the README block or the
website data file change, it commits the result back to the branch.
---
 .github/workflows/refresh-leaderboard.yml | 43 +++++++++++++++++++++++
 1 file changed, 43 insertions(+)
 create mode 100644 .github/workflows/refresh-leaderboard.yml

diff --git a/.github/workflows/refresh-leaderboard.yml b/.github/workflows/refresh-leaderboard.yml
new file mode 100644
index 0000000..094d6b3
--- /dev/null
+++ b/.github/workflows/refresh-leaderboard.yml
@@ -0,0 +1,43 @@
+name: refresh leaderboard
+
+on:
+  # Run daily so the README/website pick up new scores from
+  # millionco/react-doctor-benchmarks shortly after each benchmark run.
+  schedule:
+    - cron: "0 12 * * *"
+  workflow_dispatch:
+  # Lets the benchmarks repo poke this workflow after publishing a new
+  # leaderboard.json (configure with `gh api ... /dispatches` from there).
+  repository_dispatch:
+    types: [leaderboard-updated]
+
+jobs:
+  sync:
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write
+      pull-requests: write
+    steps:
+      - uses: actions/checkout@v5
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 24
+
+      - name: sync leaderboard data into README and website
+        run: node --experimental-strip-types scripts/sync-leaderboard.ts
+
+      - name: commit and push if changed
+        env:
+          GIT_AUTHOR_NAME: github-actions[bot]
+          GIT_AUTHOR_EMAIL: 41898282+github-actions[bot]@users.noreply.github.com
+          GIT_COMMITTER_NAME: github-actions[bot]
+          GIT_COMMITTER_EMAIL: 41898282+github-actions[bot]@users.noreply.github.com
+        run: |
+          if [ -z "$(git status --porcelain)" ]; then
+            echo "Leaderboard already up to date."
+            exit 0
+          fi
+          git add packages/react-doctor/README.md packages/website/src/app/leaderboard/leaderboard-data.json
+          git commit -m "chore: refresh leaderboard from react-doctor-benchmarks"
+          git push origin HEAD:${GITHUB_REF#refs/heads/}
-- 
